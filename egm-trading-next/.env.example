# Powers free-text answers in the chat assistant. Without it the bot falls back to canned replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Live domain, used for absolute social-share (Open Graph / Twitter) image URLs. Falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase credentials for inserting callback_requests.
# Do not prefix these with NEXT_PUBLIC_. Never commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
